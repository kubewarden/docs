<div class="nav-panel-explore{{#unless page.navigation}} is-active{{/unless}}" data-panel="explore">
  {{#if page.component}}
  <button type="button" class="context" aria-expanded="{{#if page.navigation}}false{{else}}true{{/if}}" aria-controls="component-versions">
    <span class="context-copy"><span class="context-label">Component / version</span><span class="title">{{page.component.title}}</span></span>
    <span class="version">{{#unless (eq page.component.name 'kubewarden')}}{{page.componentVersion.displayVersion}}{{/unless}}</span>
  </button>
  {{/if}}
  <ul class="components" id="component-versions">
    {{#each site.components}}
    {{#unless (eq ./name 'shared')}}
    <li class="component{{#if (eq this @root.page.component)}} is-current{{/if}}">
      <div class="title"><a href="{{{relativize ./url}}}">{{./title}}</a></div>
      {{#unless (eq ./name 'kubewarden')}}
      <ul class="versions">
        {{#each ./versions}}
        <li class="version{{#if (eq this @root.page.componentVersion)}} is-current{{/if}}{{#if (eq this ../latest)}} is-latest{{/if}}">
          <a href="{{{relativize ./url}}}"{{#if (eq this @root.page.componentVersion)}} aria-current="true"{{/if}}>{{./displayVersion}}</a>
        </li>
        {{/each}}
      </ul>
      {{/unless}}
    </li>
    {{/unless}}
    {{/each}}
  </ul>
</div>
