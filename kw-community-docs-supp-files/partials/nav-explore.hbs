{{#*inline "component-node"}}
<li class="component{{#if isCurrent}} is-current{{/if}}{{#if children.length}} component-group{{#if expanded}} is-expanded{{/if}}{{/if}}" data-component="{{name}}">
  {{#if children.length}}
  <div class="component-group-header">
    <button type="button" class="component-group-toggle" aria-expanded="{{#if expanded}}true{{else}}false{{/if}}" aria-controls="component-children-{{name}}" aria-label="Show or hide the {{title}} components"><span class="component-group-icon" aria-hidden="true"></span></button>
    <div class="title"><a href="{{{relativize component.url}}}"{{#if isCurrent}} aria-current="true"{{/if}}>{{title}}</a></div>
  </div>
  {{else}}
  <div class="title"><a href="{{{relativize component.url}}}"{{#if isCurrent}} aria-current="true"{{/if}}>{{title}}</a></div>
  {{/if}}
  {{#if includeVersions}}
  <ul class="versions">
    {{#each component.versions}}
    <li class="version{{#if (eq this @root.page.componentVersion)}} is-current{{/if}}{{#if (eq this ../component.latest)}} is-latest{{/if}}">
      <a href="{{{relativize ./url}}}"{{#if (eq this @root.page.componentVersion)}} aria-current="true"{{/if}}>{{./displayVersion}}</a>
    </li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if children.length}}
  <ul class="component-children" id="component-children-{{name}}">
    {{#each children}}
    {{> component-node}}
    {{/each}}
  </ul>
  {{/if}}
</li>
{{/inline}}
<div class="nav-panel-explore{{#unless page.navigation}} is-active{{/unless}}" data-panel="explore">
  {{#if page.component}}
  <div class="context-header">
    <div class="context-label" id="component-version-label" role="heading" aria-level="2">Component / version</div>
    <button type="button" class="context" aria-expanded="{{#if page.navigation}}false{{else}}true{{/if}}" aria-controls="component-versions" aria-labelledby="component-version-label component-version-current">
      <span class="context-row" id="component-version-current">
        <span class="title">{{page.component.title}}</span>
        <span class="version">{{#unless (eq page.component.name 'kubewarden')}}{{page.componentVersion.displayVersion}}{{/unless}}</span>
      </span>
    </button>
  </div>
  {{/if}}
  <ul class="components" id="component-versions">
    {{#each (componenthierarchy site.components page.component)}}
    {{> component-node}}
    {{/each}}
  </ul>
</div>
