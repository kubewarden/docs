# Supply-chain hardening for npm installs in this repo.
#
# ignore-scripts: block install-time scripts (preinstall/install/postinstall).
#   None of the packages currently in package-lock.json need them; if a future
#   dependency requires a native build step, it must be vetted explicitly
#   rather than silently allowed to run arbitrary code on install.
# save-exact: `npm install <pkg>` records an exact version instead of a range.
# min-release-age: refuse to install a version published less than this many
#   days ago, giving time for compromised releases to be caught and unpublished.
ignore-scripts=true
save-exact=true
min-release-age=7
